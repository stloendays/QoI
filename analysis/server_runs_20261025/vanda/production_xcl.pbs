#!/bin/bash
#PBS -N qoi_xcl_prod
#PBS -P CFP04-CF-046
#PBS -q auto
#PBS -l select=1:ncpus=36:mpiprocs=36:ompthreads=1:mem=250GB
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /scratch/junbotong/qoi-xcl-20261025/analysis/server_runs_20261025/vanda/logs/production_xcl.pbs.log
set -euo pipefail
source /scratch/junbotong/qoi-xcl-20261025/analysis/server_runs_20261025/vanda/common.sh
# 92 materials, largest first, 24 workers (as the XC study)
cut -f1 "$V/tasks_xcl.tsv" | xargs -r -P 24 -I{} bash -c 'xcl_one "$1"' _ {} || true
echo PRODUCTION_XCL_DONE

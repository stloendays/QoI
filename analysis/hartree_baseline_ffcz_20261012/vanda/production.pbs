#!/usr/bin/env bash
#PBS -N qoi_ffcz_production
#PBS -P CFP04-CF-046
#PBS -q auto
#PBS -l select=1:ncpus=36:mem=250GB
#PBS -l walltime=72:00:00
#PBS -j oe
set -euo pipefail

STAGING_ROOT="/scratch/junbotong/qoi-ffcz-20261012"
CODE_DIR="${STAGING_ROOT}/analysis/hartree_baseline_ffcz_20261012"
PYTHON="${STAGING_ROOT}/venv/bin/python"

set +eu
source /etc/profile >/dev/null 2>&1
set -eu
module load Python/3.12.3-GCCcore-13.3.0
module load FFTW/3.3.10-GCC-13.3.0
module load zstd/1.5.6-GCCcore-13.3.0
export OMP_NUM_THREADS=1
if [[ ! -s "${STAGING_ROOT}/tasks.txt" ]]; then
  "${PYTHON}" "${CODE_DIR}/run_ffcz.py" --repo-root "${STAGING_ROOT}" --list-tasks > "${STAGING_ROOT}/tasks.txt"
fi
xargs -r -P 32 -n 1 "${PYTHON}" "${CODE_DIR}/run_ffcz.py" \
  --repo-root "${STAGING_ROOT}" \
  --inputs "${STAGING_ROOT}/inputs" \
  --output-dir "${STAGING_ROOT}" \
  --phase run \
  --ffcz-exe "${STAGING_ROOT}/bin/ffcz_cpu" \
  --task < "${STAGING_ROOT}/tasks.txt"
